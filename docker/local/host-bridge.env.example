# 기존 Windows 서버와 포트 충돌을 피하기 위한 테스트용 호스트 포트.
# 실제 포트 점유 상태를 반드시 확인하고 변경한다.
FE_PORT=15173
ADMIN_PORT=15174
BACKEND_PORT=18081
VISION_PORT=18000
QWEN_PORT=18012
# 현재 Windows에서 실행 중인 Emotion API와 기존 Docker Qwen3 컨테이너로의 접근 주소.
# backend를 컨테이너화하기 전에 연결 테스트가 필요하다.
EMOTION_URL=http://host.docker.internal:18001
QWEN_URL=http://host.docker.internal:18002
# 현재 Qwen 컨테이너를 재생성하지 않으므로 아래 모델 설정은 사용하지 않는다.
QWEN_GGUF_FILE=MODEL_NOT_CONFIGURED.gguf
QWEN_CTX=2048
QWEN_THREADS=4
