# Docker Compose 환경 설정 (실제 비밀정보 없음)
# compose.local.yaml의 포트 기본값을 필요 시 변경한다.
FE_PORT=5173
ADMIN_PORT=5174
BACKEND_PORT=8080
VISION_PORT=8000
QWEN_PORT=18002
# Windows에서 직접 실행하는 기존 Emotion API
EMOTION_URL=http://host.docker.internal:18001
# Qwen 컨테이너를 이용하면 내부 서비스명 qwen을 사용한다.
QWEN_URL=http://qwen:8080
# 수동으로 배치한 GGUF 파일명으로 변경한다.
QWEN_GGUF_FILE=MODEL_NOT_CONFIGURED.gguf
QWEN_CTX=2048
QWEN_THREADS=4
