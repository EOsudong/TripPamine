<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 웹뷰(WebView) : 원격 서버(TripPamine 백엔드/프론트 서버)에 인터넷으로 접속해서
         페이지를 로드하기 위해서는 반드시 인터넷 권한이 필요하다.
         미 추가시 ANR(Application Not Responding) 또는 페이지 로딩 실패가 발생한다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TripPamine">
        <!--
            android:usesCleartextTraffic="true" 는 android:networkSecurityConfig 를
            함께 쓰면 굳이 필요 없지만(개발용 http 도메인만 허용하는 방식이 더 안전),
            수업때 배운 것처럼 가장 간단하게 http/https를 모두 허용하려면 아래 속성을
            application 태그에 추가해도 된다.
            (지금은 network_security_config.xml 로 더 세밀하게 제어한다)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
